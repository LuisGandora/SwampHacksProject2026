# Where the Planet Control API runs (a cloudflared tunnel or deployment URL for teammates and phones)
VITE_API_URL=http://127.0.0.1:8000

# Auth0 sign-in (README: "Sign-in and security"). Leave unset to run signed out against a PLANIT_DEV=1 API.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.planet-control
